# Creative Factory — environment variables
# Copy to .env and fill in. cf.py also auto-loads the Persillo .env that already
# holds GEMINI_API_KEY, so you don't *have* to duplicate it here.

GEMINI_API_KEY=
FAL_API_KEY=

# Arcads (UGC talking-head). Prefer ARCADS_BASIC_AUTH — copy the full
# 'Basic <base64>...' string from app.arcads.ai/settings/api and put it in
# single quotes to survive shell parsing.
ARCADS_BASIC_AUTH=''
# Fallback: raw API key. Some accounts get 403 with this; prefer BASIC_AUTH.
# ARCADS_API_KEY=

# Optional overrides
# VEO_MODEL=veo-3.0-generate-preview
# FAL_ENDPOINT=fal-ai/bytedance/seedance/v1/pro/image-to-video
